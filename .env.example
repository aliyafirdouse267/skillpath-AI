# Copy to .env to customize the local demo server. Never commit real secrets.
PORT=8000
DATA_FILE=./data/demo-store.json

# Optional future integrations. The current app runs in deterministic demo mode
# and does not send requests to an AI provider or Supabase.
AI_PROVIDER=demo
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
